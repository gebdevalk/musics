(ns domain-model-test
  "Unit tests for the domain data model — Composite, context wiring, and mutations.
   Run: lein test domain-model-test"
  (:require [clojure.test :refer [deftest is testing]]
            [core.domain.music-domain :as d]))

;; ============================================================
;; Wire context — leaf vs container
;; ============================================================

(deftest wire-context-leaf-replaces-context
  (let [parent-ctx (d/context-root {:amp 0.5})
        leaf (d/leaf "c4" (d/context) 1/4 [60])]
    (testing "Leaf's context is replaced by the parent composite's context"
      (let [wired (d/wire-context leaf parent-ctx)]
        (is (= parent-ctx (:context wired)))))))

(deftest wire-context-composite-sets-parent
  (let [outer-ctx (d/context-root {:amp 0.5})
        inner-pt-ctx (d/context-root {:tempo 120})
        inner (d/composite :SEQ "inner" inner-pt-ctx)]
    (testing "Composite KEEPS its own context, but parent is set"
      (let [wired (d/wire-context inner outer-ctx)]
        (is (not= outer-ctx (:context wired))
            "Composite's context is NOT replaced")
        (is (= outer-ctx (-> wired :context :parent))
            "Composite's context parent is the outer context")))))

(deftest wire-context-rest-replaces-context
  (let [parent-ctx (d/context-root {:amp 0.5})
        r (d/make-rest "r" (d/context) 1/4)]
    (testing "Rest's context is replaced by the parent composite's context"
      (let [wired (d/wire-context r parent-ctx)]
        (is (= parent-ctx (:context wired)))))))

(deftest wire-context-drum-replaces-context
  (let [parent-ctx (d/context-root {:amp 0.5})
        dm (d/drum "bd" (d/context) 1/4 36)]
    (testing "Drum's context is replaced by the parent composite's context"
      (let [wired (d/wire-context dm parent-ctx)]
        (is (= parent-ctx (:context wired)))))))

(deftest wire-context-nil-ctx-unchanged
  (let [parent-ctx (d/context-root {:amp 0.5})
        part {:id "test" :duration 1/4}]
    (testing "Part with no :context is returned unchanged"
      (let [wired (d/wire-context part parent-ctx)]
        (is (= part wired))))))

;; ============================================================
;; Composite construction
;; ============================================================

(deftest composite-empty
  (let [root (d/context-root {:tempo 120})
        c (d/composite :SEQ "test" root)]
    (is (= :SEQ (:type c)))
    (is (= "test" (:id c)))
    (is (= root (-> c :context :parent))
        "Composite's context parent is the root-ctx")
    (is (zero? (d/composite-count c))
        "Empty composite has 0 children")
    (is (empty? (d/composite-children c))
        "Empty composite returns empty children")))

(deftest composite-with-children
  (let [root (d/context-root {:tempo 120})
        leaf-a (d/leaf "a" (d/context) 1/4 [60])
        leaf-b (d/leaf "b" (d/context) 1/4 [62])
        c (d/composite :SEQ "test" root [leaf-a leaf-b])]
    (is (= 2 (d/composite-count c)))
    (is (= root (:context (first (d/composite-children c))))
        "First leaf's context is the composite's context (replacement)")
    (is (= root (:context (second (d/composite-children c))))
        "Second leaf also has composite's context")))

(deftest composite-with-nested-composite
  (let [root (d/context-root {:tempo 120})
        inner-pt-ctx (d/context-root {:amp 0.5})
        inner (d/composite :SEQ "inner" inner-pt-ctx)
        outer (d/composite :SEQ "outer" root [inner])]
    (let [ch (d/composite-children outer)]
      (is (= 1 (count ch)))
      (let [wired-inner (first ch)]
        (is (= inner-pt-ctx (:context wired-inner))
            "Nested composite KEEPS its own context")
        (is (= root (-> wired-inner :context :parent))
            "Nested composite's parent is the outer composite's context")))))

;; ============================================================
;; composite-append
;; ============================================================

(deftest append-single-leaf
  (let [root (d/context-root {:tempo 120})
        c (d/composite :SEQ "phrase" root)
        leaf (d/leaf "a" (d/context) 1/4 [60])
        result (d/composite-append c leaf)]
    (is (= c result) "composite-append returns the composite for chaining")
    (is (= 1 (d/composite-count c)))
    (is (= root (:context (first (d/composite-children c))))
        "Appended leaf has composite's context")))

(deftest append-multiple-leaf
  (let [root (d/context-root {:tempo 120})
        c (d/composite :SEQ "phrase" root)
        leaf-a (d/leaf "a" (d/context) 1/4 [60])
        leaf-b (d/leaf "b" (d/context) 1/4 [62])]
    (d/composite-append c [leaf-a leaf-b])
    (is (= 2 (d/composite-count c)))
    (let [children (d/composite-children c)]
      (is (= ["a" "b"] (map :id children)))
      (is (every? #(= root (:context %)) children)
          "All appended leafs have composite's context"))))

(deftest append-empty-vector
  (let [root (d/context-root {:tempo 120})
        c (d/composite :SEQ "phrase" root)
        leaf (d/leaf "a" (d/context) 1/4 [60])]
    (d/composite-append c leaf)
    (let [before (d/composite-count c)]
      (d/composite-append c [])
      (is (= before (d/composite-count c))
          "Appending empty vector is a no-op"))))

(deftest append-composite
  (let [root (d/context-root {:tempo 120})
        outer (d/composite :SEQ "outer" root)
        inner-pt-ctx (d/context-root {:amp 0.5})
        inner (d/composite :SEQ "inner" inner-pt-ctx)]
    (d/composite-append outer inner)
    (is (= 1 (d/composite-count outer)))
    (let [child (first (d/composite-children outer))]
      (is (= inner-pt-ctx (:context child))
          "Appended composite KEEPS its own context")
      (is (= root (-> child :context :parent))
          "Appended composite's parent is the outer composite's context"))))

;; ============================================================
;; composite-insert
;; ============================================================

(deftest insert-at-front
  (let [root (d/context-root {:tempo 120})
        c (d/composite :SEQ "phrase" root)
        leaf-a (d/leaf "a" (d/context) 1/4 [60])
        leaf-b (d/leaf "b" (d/context) 1/4 [62])]
    (d/composite-append c leaf-a)
    (d/composite-insert c 0 leaf-b)
    (is (= 2 (d/composite-count c)))
    (let [children (d/composite-children c)]
      (is (= ["b" "a"] (map :id children)))
      (is (= root (:context (first children)))
          "Inserted leaf has composite's context"))))

(deftest insert-in-middle
  (let [root (d/context-root {:tempo 120})
        c (d/composite :SEQ "phrase" root)
        leaf-a (d/leaf "a" (d/context) 1/4 [60])
        leaf-b (d/leaf "b" (d/context) 1/4 [62])
        leaf-c (d/leaf "c" (d/context) 1/4 [64])]
    (d/composite-append c [leaf-a leaf-c])
    (d/composite-insert c 1 leaf-b)
    (is (= 3 (d/composite-count c)))
    (is (= ["a" "b" "c"] (map :id (d/composite-children c)))
        "Insertion preserves correct order")))

(deftest insert-composite
  (let [root (d/context-root {:tempo 120})
        outer (d/composite :SEQ "outer" root)
        leaf (d/leaf "a" (d/context) 1/4 [60])
        inner-pt-ctx (d/context-root {:amp 0.5})
        inner (d/composite :SEQ "inner" inner-pt-ctx)]
    (d/composite-append outer leaf)
    (d/composite-insert outer 0 inner)
    (let [children (d/composite-children outer)]
      (is (= inner-pt-ctx (:context (first children)))
          "Inserted composite KEEPS its own context")
      (is (= root (-> (first children) :context :parent))
          "Inserted composite's parent is set"))))

;; ============================================================
;; composite-replace
;; ============================================================

(deftest replace-returns-old
  (let [root (d/context-root {:tempo 120})
        old-leaf (d/leaf "old" (d/context) 1/4 [60])
        new-leaf (d/leaf "new" (d/context) 1/4 [62])
        c (d/composite :SEQ "phrase" root [old-leaf])
        returned (d/composite-replace c 0 new-leaf)]
    (is (= "old" (:id returned)) "Returns the old child")
    (is (= 1 (d/composite-count c)) "Count stays the same")
    (is (= "new" (:id (first (d/composite-children c))))
        "Child is replaced")
    (is (= root (:context (first (d/composite-children c))))
        "Replaced child has composite's context")))

(deftest replace-composite
  (let [root (d/context-root {:tempo 120})
        leaf (d/leaf "a" (d/context) 1/4 [60])
        inner-pt-ctx (d/context-root {:amp 0.5})
        inner (d/composite :SEQ "inner" inner-pt-ctx)
        c (d/composite :SEQ "outer" root [leaf])
        returned (d/composite-replace c 0 inner)]
    (is (d/leaf? returned) "Returns the old leaf")
    (let [child (first (d/composite-children c))]
      (is (= inner-pt-ctx (:context child))
          "Replaced composite KEEPS its own context")
      (is (= root (-> child :context :parent))
          "Replaced composite's parent is set"))))

;; ============================================================
;; composite-children (snapshot immutability)
;; ============================================================

(deftest children-snapshot-immutable
  (let [root (d/context-root {:tempo 120})
        leaf-a (d/leaf "a" (d/context) 1/4 [60])
        c (d/composite :SEQ "test" root)
        snapshot (d/composite-children c)]
    (d/composite-append c leaf-a)
    (is (zero? (count snapshot))
        "Snapshot is not affected by subsequent mutations")))

;; ============================================================
;; composite-count
;; ============================================================

(deftest count-after-mutations
  (let [root (d/context-root {:tempo 120})
        leaf-a (d/leaf "a" (d/context) 1/4 [60])
        leaf-b (d/leaf "b" (d/context) 1/4 [62])
        leaf-c (d/leaf "c" (d/context) 1/4 [64])
        c (d/composite :SEQ "test" root)]
    (is (zero? (d/composite-count c)) "Freshly created: 0")
    (d/composite-append c leaf-a)
    (is (= 1 (d/composite-count c)) "After 1 append: 1")
    (d/composite-append c [leaf-b leaf-c])
    (is (= 3 (d/composite-count c)) "After batch append: 3")
    (d/composite-remove c leaf-b)
    (is (= 2 (d/composite-count c)) "After remove: 2")))

;; ============================================================
;; make-score
;; ============================================================

(deftest score-root-only
  (let [root (d/context-root {:tempo 120})
        score (d/make-score root)]
    (is (= :SCORE (:type score)))
    (is (= "score" (:id score)))
    (is (zero? (d/composite-count score))
        "Empty score has no children")))

(deftest score-with-part
  (let [root (d/context-root {:tempo 120})
        leaf (d/leaf "c4" (d/context) 1/4 [60])
        score (d/make-score root leaf)]
    (is (= 1 (d/composite-count score)))
    (let [child (first (d/composite-children score))]
      (is (= "c4" (:id child)))
      (is (= root (:context child))
          "Leaf's context is replaced by score's root context (leaf wiring)"))))

(deftest score-with-composite
  (let [root (d/context-root {:tempo 120})
        inner-pt-ctx (d/context-root {:amp 0.5})
        inner (d/composite :SEQ "phrase" inner-pt-ctx)
        score (d/make-score root inner)]
    (let [child (first (d/composite-children score))]
      (is (= inner-pt-ctx (:context child))
          "Nested composite KEEPS its own context")
      (is (= root (-> child :context :parent))
          "Nested composite's parent is the score's context"))))

;; ============================================================
;; Parent-chain integrity — deeper trees
;; ============================================================

(deftest leaf-under-nested-composite
  "A leaf inside a nested composite: leaf's context is the inner composite's
   context, not the outer composite's context."
  (let [root (d/context-root {:tempo 120})
        leaf (d/leaf "c4" (d/context) 1/4 [60])
        inner (d/composite :SEQ "inner" (d/context-root {:amp 0.5}) [leaf])
        outer (d/composite :SEQ "outer" root [inner])]
    (let [outer-child (first (d/composite-children outer))
          inner-child (first (d/composite-children outer-child))]
      (is (= (:context outer-child) (:context inner-child))
          "Leaf's context is the inner composite's context (replacement)")
      (is (= (:context outer) (-> outer-child :context :parent))
          "Inner composite's parent is outer composite's context"))))

(deftest context-tree-after-multiple-appends
  "Build a multi-level tree via append, verify the parent chain."
  (let [root (d/context-root {:tempo 120})
        score (d/composite :SCORE "piece" root)
        section (d/composite :SEQ "verse" (d/context-root {:amp 0.6}))
        note-a (d/leaf "c4" (d/context) 1/4 [60])
        note-b (d/leaf "d4" (d/context) 1/4 [62])]
    (d/composite-append section [note-a note-b])
    (d/composite-append score section)
    (is (= 1 (d/composite-count score)))
    (is (= 2 (d/composite-count section)))
    (let [sec (first (d/composite-children score))
          notes (d/composite-children sec)
          n1 (first notes)
          n2 (second notes)]
      (is (= (:context score) (-> sec :context :parent))
          "Section composite's parent is score's context")
      (is (= (:context sec) (:context n1))
          "First note's context is section's context (replacement)")
      (is (= (:context sec) (:context n2))
          "Second note's context is section's context (replacement)"))))
