// hoketus01 -- hoketus0 with the density growing: one pulse more each pass.
//
// Hear it:    "mus/hoketus01.mus" load   start
// Change it:  while it plays, 8 :steps T!   or   1/4 :lag T!
// Stop it:    stop

'rhythmic.pattern 'p reqalgo          // p/euclid
'bridge 'b reqalgo                    // b/pul>evnt

16 :steps T!                      // pulses of a pass
'( :onset 16 * :steps / int :steps mod 1 + ) :density T!   // notes of a pass: 1, 2 ... steps, then round again
1/8 :lag T!                       // how late voice B is (a pulse is 1/16)
'[64 67 71 69 74 71 67 66 64 69 71 76 74 71 67 69]  :melody T!

: one ( $x -- list ) '[1] $x * ;
: bit ( $flag -- n ) $flag '( 1 ) '( 0 ) if ;

// the pulse the onset is on, late by lag
: pulse-at ( $onset $lag -- i ) $onset $lag - 16 * int :steps T@ mod ;

// the leaf of pulse i: the melody's note if the Euclidean pattern has it on, else a rest
: pulse ( $i $pan -- leaf )
  | ( :density T@@ :steps T@ p/euclid $i @ 1 = bit ) 1/16 b/pul>evnt 1 take
    :melody T@ $i @ one  :pan $pan one  :instrument 12 one  :volume 80 one  zip ;

// the voice: a rest until its start (late by lag), then pulse after pulse
: hoke ( $onset $pan $late -- leaf )
  $late :lag T@ * $onset >
  '( [] $late :lag T@ * $onset - delay )
  '( $onset $late :lag T@ * pulse-at  $pan  pulse )
  if ;

100 :tempo T!
: tempo-ctx ( $tempo -- ctx ) | :duration '[1] :Tempo '[1] $tempo * >ctx ;

: start-voices ( $ctx -- )
  -1 0 'hoke $ctx :A ->+     1 1 'hoke $ctx :B ->+ ;

: start ( -- ) stop :tempo T@ tempo-ctx start-voices ;b  
