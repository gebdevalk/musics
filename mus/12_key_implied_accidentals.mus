% 12_key_implied_accidentals.mus -- audible test: a bare pitch letter
% resolving against the active key's own implied accidental (:implied,
% the default), contrasted against literal/LilyPond-style resolution
% (:explicit) under the exact same key and notes.

{key_implied_scale:
  !accidentals:implied
  !key:D.major
  D4/4 E4/4 F4/4 G4/4 A4/4 B4/4 C5/4 D5/4
  r4
  Fn4/4 Cn4/4                % explicit natural overrides the key either way
}

{key_explicit_scale:
  !accidentals:explicit
  !key:D.major
  D4/4 E4/4 F4/4 G4/4 A4/4 B4/4 C5/4 D5/4
}
