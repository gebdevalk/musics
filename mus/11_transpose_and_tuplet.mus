% 11_transpose_and_tuplet.mus -- audible test: \transpose and
% \times/\tuplet, both spelling their body with Scope ( ), never a
% retained container of their own.

motif = (C4/4 d e f g f e d)

{transpose_demo:
  \motif
  r4
  \transpose c g (\motif)   % up a fifth
  r4
  \transpose c f (\motif)   % up a fourth
}

{times_and_tuplet_demo:
  \times 2/3 (C4/4 d e)    % three notes in the time of two
  \tuplet 3/2 (F4/4 g a)   % same idea, LilyPond-style spelling
  \motif
}
