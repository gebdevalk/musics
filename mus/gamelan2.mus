// gamelan2 -- layers of melodic material from the harmonic series.
//
// Four bars (:span, in whole notes) are divided again and again: each layer plays notes
// of the previous layer's length divided by the next division. [2 2 2 2 2 2] gives notes of
// 2, 1, 1/2, 1/4, 1/8 and 1/16 of a whole note, [2 3 2 2] of 2, 2/3, 1/3 and 1/6.
// Every layer plays pitches of a window over the harmonic series -- at least two of them,
// :width -- that climbs, a cycle of four bars at a time, from octave 2 (:bottom) up to
// octave 5 (:top, 84 is octave 6). The layers enter one after another (:entry cycles apart).
// Then it breaks down again, the layers leaving in the opposite order and the window falling
// back, and builds up again: :climb cycles up, :climb cycles down, round and round.
//
// Hear it:    "mus/gamelan2.mus" load   start
// Change it:  while it plays: '[2 3 2 2] :divisions T!    5 :width T!    84 :top T!
//             0 :entry T!    '[12 14 11] :timbres T!      (what a voice reads, it reads
//             again at its next note; the layers started are :l0 .. :l7, as many as divisions)
// Stop it:    stop

"clojure.math" 'm require             // m/log
'bridge 'b reqalgo                    // b/pul>evnt

// ---- the settings: plain values in the tctx --------------------------------

4 :span T!                            // whole notes in a cycle: four bars of 4/4
'[2 2 2 2 2 2] :divisions T!          // layer k: the span divided by the first k+1 of these
24 :fundamental T!                    // C1: the series' fundamental, a MIDI note
64 :harmonics T!                      // how many harmonics of it
36 :bottom T!                         // the window starts at this pitch: octave 2 (C2) ...
72 :top T!                            // ... and climbs to this one: octave 5 (C5)
24 :climb T!                          // cycles of four bars the build-up takes, and the break-down
3 :width T!                           // pitches in the window, two at least
2 :entry T!                           // cycles between one layer's entry and the next's
70 :level T!                          // volume of the slowest layer, the others a little softer
'[14 11 12 13 9 10 8 6] :timbres T!   // programs: bells, vibraphone, marimba, xylophone, ...

// ---- the harmonic series ----------------------------------------------------

// the pitches of the first n harmonics of f0: 12 semitones for each doubling, to the nearest
// semitone, each pitch once (high harmonics lie closer than a semitone)
: harmonics ( $f0 $n -- pitches )
  1 $n 1 + range  '( m/log 2 m/log /  12 *  round  $f0 + ) map  distinct ;

// ---- what changes with the onset: derived settings ---------------------------

'( :onset :span / int ) :cycle T!                              // which cycle of four bars
// how far the build-up has come: 0 up to :climb over :climb cycles, then back down to 0
// over as many, and again (a triangle over 2*:climb cycles)
'( :cycle :climb 2 * mod  :climb swap - abs  :climb swap - ) :height T!
'( :height :climb /  :top :bottom - *  :bottom + ) :lo T!     // the window's lower edge, climbing and falling
'( :fundamental T@@ :harmonics T@@ harmonics ) :series T!      // the harmonic series, as pitches
// the window: the first :width series pitches from the lower edge up, two at least
'( :series T@@ '( :lo >= ) filter  :width T@@ 2 max take ) :window T!

// ---- a layer ---------------------------------------------------------------

// the length of one note of layer k: the span divided by the first k+1 divisions
: layer-length ( $k -- d )
  :divisions T@@ $k 1 + take  :span T@@ '( / ) reduce ;

// a pitch of the window for the note the onset is in: the layers step through it a note
// apart, layer k starting k pitches in
: layer-pitch ( $onset $k $d -- pitch )
  :window T@@ dup length  $onset $d / int $k +  swap mod  @ ;

: bit ( $flag -- n ) $flag '( 1 ) '( 0 ) if ;

// pan from the left (the slowest layer) to the right (the fastest)
: layer-pan ( $k -- pan )
  $k  :divisions T@@ length 1 - 1 max  /  9/5 *  9/10 -  float ;

// the leaf: dur is a note's length, or a rest's; loud is added to the volume
: layer-leaf ( $dur $pitch $k $loud -- leaf )
  | $dur $pitch
    :pan $k layer-pan
    :instrument :timbres T@@ dup length $k swap mod @
    :volume :level T@@ $k 5 * - $loud +
    leaf ;

// one note of layer k at an onset: the grid of its length is kept even when the divisions
// change (the note lasts to the next point of it), a layer that has not entered -- or has
// left again in the break-down -- is a rest, the first note of a cycle is louder
: layer ( $onset $k -- leaf )
  $k layer-length  dup $onset swap mod  over swap -               // d, and the length left
  :height T@@ $k :entry T@@ * >=  bit  '[1] swap *                // d len '[sounds?]
  swap b/pul>evnt 0 @                                             // d dur
  $onset $k 3 pick layer-pitch                                    // d dur pitch
  rot drop                                                        // dur pitch
  $k  $onset :span T@@ mod 0 =  bit 12 *                          // dur pitch k loud
  layer-leaf ;

// ---- start and stop ---------------------------------------------------------

120 :tempo T!                         // quarter notes a minute

: tempo-ctx ( $tempo -- ctx ) | :duration 1 :Tempo $tempo >ctx ;

// layer k as the voice id, if there are that many divisions
: start-layer ( $k $ctx $id -- )
  $k :divisions T@@ length <
  '( $k 'layer $ctx $id ->+ )
  '( )
  if ;

: start-voices ( $ctx -- )
  0 $ctx :l0 start-layer   1 $ctx :l1 start-layer   2 $ctx :l2 start-layer   3 $ctx :l3 start-layer
  4 $ctx :l4 start-layer   5 $ctx :l5 start-layer   6 $ctx :l6 start-layer   7 $ctx :l7 start-layer 
  ;

: start ( -- ) stop :tempo T@ tempo-ctx start-voices ;

: stop-gamelan ( -- ) stop ;
