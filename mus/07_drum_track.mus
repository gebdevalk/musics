% 07_drum_track.mus -- audible test: a drum track.
%
% Drum = 'x' Duration DrumMod?, DrumMod a \name (common/music_data.clj's
% `drums` abbr table) or a raw \Int MIDI note. Two simultaneous voices
% (<< >>, Parallel) -- a running hi-hat ostinato against a kick/snare
% backbeat -- with bar lines (|) marking the two measures.

!Meter:4/4

{drum_track:
<<
  {hats:
    x8\hhc x8\hhc x8\hhc x8\hhc x8\hhc x8\hhc x8\hhc x8\hhc |
    x8\hhc x8\hhc x8\hhc x8\hhc x8\hhc x8\hhc x8\hhc x8\hho
  }
  {kick_snare:
    x4\bd1 x4\sna x4\bd1 x4\sna |
    x4\bd1 x4\bd1 x4\sna x4\cr1
  }
>>
}
