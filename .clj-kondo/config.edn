{:hooks {:macroexpand {musics.algo.tree/defalgo hooks.defalgo/defalgo
                       clojure.core.logic/run hooks.core-logic/run
                       clojure.core.logic/run* hooks.core-logic/run*}}
 ;; core.logic's fresh binds fresh variables: a vector of names, like fn's
 :lint-as {clojure.core.logic/fresh clojure.core/fn}
 ;; musics.algo.tree/expose names each constructor from its fn's :algo :short
 ;; metadata, which clj-kondo can't read -- so it can't see musics.algo.tree.lib's
 ;; exposed names (euclid, indisp, tilt, ...).
 ;; musics.algo.tree/expose-ns takes namespace names as bare symbols.
 ;; musics.mu.words interns mu's words from its registry (musics.mu.bridge).
 ;; musics.engine locks on the engine's own :lock, (locking (:lock eng) …):
 ;; one Object per engine, not a local -- clj-kondo can't tell.
 :linters {:locking-suspicious-lock {:level :off}
           :unresolved-var {:exclude [musics.algo.tree.lib musics.mu.words]}
           :unresolved-symbol {:exclude [(musics.algo.tree/expose-ns)]}}}
