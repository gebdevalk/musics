(* ============================================================
   musics.ebnf — Instaparse grammar for the musics DSL

   Placement:  src/input/reader/musics.ebnf
   Goal:       Replace the hand-rolled lexer + recursive-descent parser
               (parser/lexer.clj + parser/music_parser.clj) with a
               single declarative grammar processed by instaparse.

   Pre-processing pipeline (unchanged):
     vars/extract-vars  →  vars/expand-vars  →  strip-comments

   Post-processing:
     Walk the instaparse tree → domain objects
     (replaces music_parser.clj dispatch logic)

   What stays:
     - vars.clj          (variable definition/expansion)
     - leaf_parser.clj   (pitch→MIDI resolution, articulation lookup)
     - music_data.clj / music_elements.clj / music_domain.clj

   Deferred validation (tree-walker checks against data maps):
     - BangConst → music_data.clj / instruction-context
     - Ornament  → ornaments.clj / ornament-map
     - Articulation (word) → music_data.clj / articulations
     - Drum name → music_data.clj / drum-name->midi
   ============================================================ *)


(* ── Top level ─────────────────────────────────────────────── *)

Program     = ws? (VarDef | Element)*

<Element>   = Composite | Instruction | Note | Chord | Rest | Drum
            | Float | Int | StringLit | Keyword | BareWord


(* ── Variable definitions ────────────────────────────────────
   Handled here so the grammar can parse test files that still
   contain `name = value` lines. In production, vars.clj will
   strip these first. *)

VarDef          = Name ws? <'='> ws? VarValue

<VarValue>      = VarValueSingle | VarValueMulti
VarValueSingle  = #'[^\n]*'
VarValueMulti   = <'['> (VarValueMulti | #'[^\n\[\]]*' | #'\n')* <']'>


(* ── Composites ────────────────────────────────────────────── *)

<Composite>     = Sequence | Parallel | Data | List | Quoted

Sequence        = <'{'>  ws? (BareWord ws?)? Element* ws? <'}'>
Parallel        = <'<<'> ws? (BareWord ws?)? Element* ws? <'>>'>
Data            = <'['>  ws? Element* ws? <']'>
List            = <'('>  ws? Element* ws? <')'>
Quoted          = <'\'('> ws? Element* ws? <')'>


(* ── Instructions ────────────────────────────────────────────
   Ordered: KeyAssignment before Assignment so !key:C doesn't
   get consumed as ! + key + :C assignment.
   BangConst uses open Name — tree-walker validates against
   music_data.clj/instruction-context. *)

<Instruction>   = BangConst | KeyAssignment | Assignment

BangConst       = <'!'> ws? Name
KeyAssignment   = <'!key:'> KeySpec
Assignment      = <'!'> ws? Name ws? <':'> ws? Value

<Value>         = Ramp | Float | Int | StringLit | QualifiedName | StructValue
Ramp            = CurvePrefix? Direction
StructValue     = <'('> ws? Element* ws? <')'>
QualifiedName   = Name (<'.'> Name)*
KeySpec         = #'[A-Ga-g][b#]?(?:\.[a-zA-Z][a-zA-Z0-9_]*)*'

(* ── Ramp direction & curve ───────────────────────────────── *)
CurvePrefix     = 'l' | 's' | 'i' | 'o'
Direction       = '<' | '>'


(* ── Notes ─────────────────────────────────────────────────── *)

Note            = Pitch Duration? Articulation? NoteSuffix* Tie?

Pitch           = PitchLetter Accidental? Octave?

PitchLetter     = #'[A-Ga-gp]'
Accidental      = #'[b#n]{0,2}'

<Octave>        = OctaveAbs | OctaveTicks
OctaveAbs       = #'[1-8]/'
OctaveTicks     = #"[']*|[,]*"


(* ── Duration ──────────────────────────────────────────────── *)

<Duration>      = DurationSpecial | DurationNum
DurationSpecial = 'longa' | 'breve'
DurationNum     = #'\d{1,3}\.*'


(* ── Articulation ────────────────────────────────────────────
   Shorthand chars or full word. Tree-walker validates word
   against music_data.clj/articulations. *)

Articulation    = <'-'> (ArticulationShorthand | Name)
ArticulationShorthand = #'[-.>^_!+]'


(* ── Modifiers & Ornaments ───────────────────────────────────
   Ornament names validated by tree-walker against
   ornaments.clj/ornament-map. *)

<NoteSuffix>    = Modifier | Ornament
Modifier        = <'\\'> Name <':'> ModValue
Ornament        = <'\\'> Name
<ModValue>      = Float | Int | StringLit | Name


(* ── Tie ───────────────────────────────────────────────────── *)

Tie             = <'~'>


(* ── Chord (negative-lookahead avoids << conflict) ─────────── *)

Chord           = <'<' !'<'> ChordPitches <'>'> Duration? Articulation? Modifier* Tie?
<ChordPitches>  = Pitch+


(* ── Rest ──────────────────────────────────────────────────── *)

Rest            = <'r'> Duration?


(* ── Drum ──────────────────────────────────────────────────── *)

Drum            = <'x'> Duration? DrumMod?
DrumMod         = <'\\'> (Int | Name)


(* ── Primitives ────────────────────────────────────────────── *)

Name            = #'[a-zA-Z][a-zA-Z0-9_]*'
Float           = #'[0-9]+\.[0-9]+'
Int             = #'[0-9]+'
StringLit       = <'"'> #'[^"]*' <'"'>
Keyword         = <':'> #'[a-zA-Z0-9_][a-zA-Z0-9_\-]*'

(* BareWord: a Name that didn't match any more-specific Element.
   Must appear LAST among Element alternatives. *)
BareWord        = Name


(* ── Whitespace (hidden in output tree) ────────────────────── *)
<ws>            = #'\s+'
