(* ============================================================
   musics.ebnf — Instaparse grammar for the musics DSL
   ============================================================
   Inspired by LilyPond but this is a custom DSL.

   Bracket system:
     [ ]      Sequence
     { }      Parallel
     ( )      Unit         (grouped elements, no context of its own)
     '[ ]     Data
     @'[ ]    AtomicAlgo   (algo over data)
     @[ ]     ElementAlgo  (algo over elements)
     ^[ ]     Context      (named context / envelope definition)

   Id        = Name ':'    definition: registers in repo
   Reference = ':' Name    reference:  looks up in repo
   ============================================================ *)

Program = ws? (Element (ws Element)*)? ws?

(* Element: musical parts, instructions, commands *)
<Element> = Part | Instruction | Command

(* Part: a composite pattern of musical data *)
<Part> = Composite | Leaf | Reference
<Leaf> = Chord | Note | Rest | Drum

(* Bar / section markers -- pure structural signals for a future conductor,
   no effect on musical timing. Four levels of granularity, finest to
   coarsest: | (bar/measure) || ||| |||| (progressively larger parts).
   Reachable only through Sep below (Sequence/Parallel element lists), not
   through Element/Leaf/Instruction -- so it never needs surrounding
   whitespace: c4|d4, c4 |d4, c4| d4, c4 | d4 are all one bar line. *)
BarLine = #'\|{1,4}'

(* Element-list separator for Sequence/Parallel: a plain gap (ws, possibly
   with comments) or a bar line with optional whitespace on either side.
   Hidden rule -- a BarLine match bubbles up as a normal sibling in the
   parent's children, same as any other hidden-rule passthrough. *)
<Sep> = ws
      | ws? BarLine ws?

(* A bar line at the very start or end of a Sequence/Parallel body -- e.g.
   a closing bar before the ']', or a pickup bar before the first note.
   Always requires at least the BarLine itself (unlike Sep, never just ws),
   so it can't collide with the plain ws? already flanking the body. *)
<EdgeBar> = ws? BarLine ws?

(* ── Composites ─────────────────────────────────────────── *)

<Composite> = Context | Sequence | Parallel | Unit | Data | AtomicAlgo | ElementAlgo

Context     = <'^['> ws? (Id ws)?  Instruction (ws Instruction)* ws? <']'>
            | <'^['> ws? (Id ws)                                 ws? <']'>

Sequence    = <'['>   ws? (Id ws)? EdgeBar? Element (Sep Element)* EdgeBar? ws? <']'>
            | <'['>   ws? (Id ws)                                          ws? <']'>

(* ParElement's alternatives (Context/Sequence/Reference/Instruction/
   Command) all start with a distinctive non-alphanumeric character
   (^ [ : ! \), so two of them can sit directly adjacent with no
   separator at all -- Sep is optional here, not just the bar line
   covered by EdgeBar. *)
Parallel    = <'{'>   ws? (Id ws)? EdgeBar? ParElement (Sep? ParElement)* EdgeBar? ws? <'}'>
            | <'{'>   ws? (Id ws)                                                 ws? <'}'>

(* Unit: an ordered group of Elements that shares its enclosing
   container's context instead of carrying one of its own -- a shuffling/
   randomizing algorithm can reorder Units within a Sequence and the notes
   inside each one travel together. Same body shape as Sequence
   (including bar lines), just parenthesized. *)
Unit        = <'('>   ws? (Id ws)? EdgeBar? Element (Sep Element)* EdgeBar? ws? <')'>
            | <'('>   ws? (Id ws)                                          ws? <')'>

Data        = <"'[">  ws? (type ws)? (DataElement (ws DataElement)*)? ws? <']'>

AtomicAlgo  = <"@'["> ws? (algo ws) (Data (ws Data)*)? ws? <']'>

ElementAlgo = <'@['>  ws? (algo ws) (Element (ws Element)*)? ws? <']'>

type = Name
algo = Name

(* ParElement: like Element but without bare Leafs. Unit is deliberately
   excluded -- its purpose is preserving grouping under reordering, and
   Parallel's children have no sequential order to reorder in the first
   place (they're simultaneous, not sequential), so there's no use case
   for it here. *)
<ParElement> = Context | Sequence | Reference | Instruction | Command

(* DataElement: element for data containers *)
<ExtendedDataElement> = Atom | Primitive | Keyword | Name
<DataElement>         = Atom | Primitive
<Atom>                = Pitch | Duration | Articulation | BangConst | StringLit
<Primitive>           = Ratio | Float | Int

(* ── Commands ───────────────────────────────────────────── *)

<Command> = transpose | times | tuplet | repeat | tremolo | grace

(* Transpose *)
transpose  = #'\\transpose' ws from-pitch ws to-pitch ws Sequence
from-pitch = Pitch
to-pitch   = Pitch

(* Tuplets *)
times  = #'\\times'  ws multiply-factor ws Sequence
tuplet = #'\\tuplet' ws divide-factor   ws Sequence

multiply-factor = Ratio
divide-factor   = Ratio

(* Repeats *)
repeat = #'\\repeat' ws repeat-type ws repeats ws Element (ws volta)?
<repeat-type> = 'volta' | 'unfold'
volta   = #'\\alternative' ws Sequence
repeats = Int

(* Measured tremolo -- single note/chord tremolo is a NoteSuffix *)
tremolo = #'\\repeat' ws 'tremolo' ws divisor ws Sequence
divisor = Int

(* Grace Notes
   All five forms now capture two Elements: the grace note and the main
   note it borrows time from. Order differs by keyword:
     \grace/\acciaccatura/\appoggiatura/\slashedGrace  -- grace-note main-note
     \afterGrace                                       -- main-note grace-note *)
grace = #'\\grace'        ws Element ws Element
      | #'\\acciaccatura' ws Element ws Element
      | #'\\appoggiatura' ws Element ws Element
      | #'\\slashedGrace' ws Element ws Element
      | #'\\afterGrace'   ws Element ws Element

(* ── Instructions ───────────────────────────────────────── *)

<Instruction> = BangConst | KeyAssignment | Assignment | SlurStart | SlurEnd

BangConst     = <'!'> Name
KeyAssignment = <'!key:'> KeySpec
Assignment    = <'!'> Name Ramp
              | <'!'> Name <':'> Value
SlurStart     = <'!('>
SlurEnd       = <'!)'>

<Value> = Ratio | Float | Int | StringLit | QualifiedName | StructValue

(* ── Ramp ───────────────────────────────────────────────── *)
(*
   A Ramp is a Value in its own right, but unlike every other Value it
   attaches directly to the assignment name with no colon -- the ramp's
   own leading < or > reads as the separator instead. The curve prefix
   (if any) comes right after the direction, not before it as glued to
   the name -- Name is a greedy letter regex, so a prefix glued onto the
   name (`!vols<...`) is ambiguous about where the name ends; anchored
   after < or >, a letter there can only ever be the curve prefix.
   Four forms:
   - Open-ended, no curve:    !vol<          direction only, no target
   - Open-ended, with curve:  !vol<s         curve set now, target later
   - Timed, no curve:         !vol<16:ff     duration + target
                              !vol<16*4:ff   duration as product
                              !vol<16/1:ff   duration as ratio
                              !pan<4:1.0     float target
                              !tempo>8:60    int target
   - Timed, with curve:       !vol<s:16:ff   curve, duration, target --
                              a ramp point really is this (curve, duration,
                              target) triple; the plain timed form just
                              defaults curve to linear.

   No colon is needed between the curve letter and the duration --
   CurvePrefix is always a single letter and DurationExpr always starts
   with a digit, so the two token classes never collide -- but the timed
   form keeps one for readability, matching a (curve, duration, target)
   triple read left to right. Assignment itself no longer contributes a
   colon for this Value type; the only colon(s) left are internal to Ramp.
*)

Ramp         = Direction CurvePrefix?
             | Direction              DurationExpr <':'> Target
             | Direction CurvePrefix <':'> DurationExpr <':'> Target

DurationExpr = DurationAtom (<'*'> DurationAtom)*
DurationAtom = Ratio | Int

Target       = DynamicMark | Float | Int

DynamicMark  = 'pppp' | 'ppp' | 'pp' | 'p' | 'mp' | 'mf'
             | 'ffff' | 'fff' | 'ff' | 'f'

StructValue   = <'('> ws? (ExtendedDataElement (ws ExtendedDataElement)*)? ws? <')'>
QualifiedName = Name (<'.'> Name)*
KeySpec       = #'[A-Ga-g][b#]?(?:\.[a-zA-Z][a-zA-Z0-9_]*)*'

<CurvePrefix> = 'l' | 's' | 'i' | 'o'
<Direction>   = '<' | '>'

(* ── Notes ──────────────────────────────────────────────── *)

Note  = Pitch Duration Articulation? NoteSuffix* Tie?
      | Pitch           Articulation? NoteSuffix* Tie?

Pitch       = PitchLetter Accidental? Octave?
PitchLetter = #'[A-Ga-gp]'
Accidental  = #'##|bb|[#bn]'

<Octave>    = OctaveAbs | OctaveTicks
OctaveAbs   = #'[1-8]/'
OctaveTicks = #"'+|,+"

(* ── Duration ───────────────────────────────────────────── *)

<Duration>      = DurationSpecial | DurationNum
DurationSpecial = #'\\longa' | #'\\breve'
DurationNum     = #'[1-9][0-9]?\.*'

(* ── Articulation ───────────────────────────────────────── *)

Articulation          = <'-'> ArticulationShorthand
                      | <#'\\'> ArticulationName
ArticulationName      = 'staccato' | 'staccatissimo' | 'tenuto' | 'marcato' |
                        'portato'  | 'accent'         | 'espressivo'
ArticulationShorthand = #'[-.>^_!+]'

(* ── Modifiers, Ornaments, Tremolo ──────────────────────── *)

OrnamentName = 'prall'     | 'prallup'      | 'pralldown'   | 'upprall'     |
               'downprall' | 'prallprall'   | 'lineprall'   | 'prallmordent'|
               'mordent'   | 'upmordent'    | 'downmordent' |
               'trill'     | 'turn'         | 'reverseturn' |
               'shortfermata' | 'fermata'   | 'longfermata' | 'verylongfermata'

Ornament = <#'\\'> OrnamentName
Modifier = <#'\\'> Name <':'> ModValue
Tremolo  = <':'> Int

<ModValue>   = Float | Int | StringLit | Name

(* Tremolo is a note/chord suffix: c4:32, <c e g>4:32
   Measured tremolo (\repeat tremolo N seq) is a Command *)
<NoteSuffix> = Modifier | Ornament | Tremolo

(* ── Tie ─────────────────────────────────────────────────── *)

Tie = '~'

(* ── Chord ───────────────────────────────────────────────── *)

Chord = '<' !'<' ChordPitches '>' Duration Articulation? NoteSuffix* Tie?
      | '<' !'<' ChordPitches '>'          Articulation? NoteSuffix* Tie?

<ChordPitches> = Pitch ws Pitch (ws Pitch)*

(* ── Rest ────────────────────────────────────────────────── *)

Rest = 'r' Duration
     | 'r'

(* ── Drum ────────────────────────────────────────────────── *)

Drum    = 'x' Duration DrumMod?
        | 'x'          DrumMod?
DrumMod = <#'\\'> (Int | Name)

(* ── Primitives ──────────────────────────────────────────── *)

Name      = #'[a-zA-Z][a-zA-Z0-9_]*'
Float     = #'[0-9]+\.[0-9]+'
Int       = #'[0-9]+'
Ratio     = #'[0-9]+/[0-9]+'
StringLit = <'"'> #'[^"]*' <'"'>
Keyword   = <':'> #'[a-zA-Z0-9_][a-zA-Z0-9_\-]*'
Id        = Name <':'>
Reference = <':'> Name

(* ── Whitespace ──────────────────────────────────────────── *)
(* Allows: blanks, newlines, block comments %{...%},
   line comments % or ; to end of line.
   Bar lines '|' are no longer swallowed here -- they're BarLine, matched
   via Sep in Sequence/Parallel (see above), not by ws itself. *)
<ws> = #'(\s|%\{[\s\S]*?%\}|%[^\n]*|;.*)+'