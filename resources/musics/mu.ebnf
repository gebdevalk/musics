(* mu: the musical REPL's own rules (doc/md/mu-repl.md). They are appended
   to musics.ebnf, so every musical literal is musics text, exactly as
   in a .mus file; mu adds only what a stack language needs, and starts
   at MuInput.

   An input is a sequence of items separated by whitespace. Choices are
   ordered (/): a leaf always wins over a word, so a bare a, c4 or R is a
   note or a rest, and only what is no leaf can be a word. *)

MuInput = <ws>? (MuItem (<ws> MuItem)*)? <ws>?

<MuItem> = Definition / Quotation / TopCommand / Group / Retrograde / Measures / EmptyLine / Parallels / Lines / QuotedName
         / TreeRecipe / Settings / Composite / repeat / RepeatBars / tuplet / shuffle / rotate / choose / alternate / KeyValue / Leaf / Mark / MuNumber / BareDuration / StringLit
         / KeyLit / AssignLit / IdName / VarRef / PcSet / Local / LooseInstruction / Word

(* : name ( $a b -- c ) body ;  -- a $name before -- is bound as a local and taken off
   the stack, a plain one stays on it; after -- a name is a result (x the same, x' changed,
   a new name a new thing); name... is any number (musics.mu.eval, doc/md/mu-repl.md).
   The colon needs whitespace after it,
   which tells it from :name (a repo name) and name: (an id). *)
Definition  = <':'> <ws> WordName (<ws> StackEffect)? (<ws> MuItem)* <ws>? <';'>
StackEffect = <'('> <ws>? EffectIn <'--'> EffectOut <ws>? <')'>
EffectIn    = (EffectName <ws>)*
EffectOut   = (<ws> EffectName)*
<EffectName> = #'\$?[a-zA-Z_][a-zA-Z0-9_\-]*\'*(\.\.\.|…)?' / #'\.\.\.|…'

(* A tree recipe: an algo tree written concatenatively, as mu is --
   @( riff: ^{ seed:7 } k:3 n:8 euclid len:8 pitch/walk zip ) (musics.recipe),
   the algo twin of '( ) as @^{ } is of ^{ }. An id first names it, as a
   part names itself, and R! stores it under that name. Inside, words
   build the tree on a stack of their own: an algo takes the params and
   the 'alias lying on top, then its inputs, and pushes itself; zip and
   par join the top two (or all above a |); dup swap over rot arrange;
   data and numbers are leaves. ^{ … } first is the head, the settings
   of the whole tree. No music inside: music comes from the stack under
   the recipe. *)
TreeRecipe   = <'@('> <ws>? (Id <ws>)? (TreeHead (<ws> TreeItem)* / TreeItem (<ws> TreeItem)*)? <ws>? <')'>
TreeHead     = <'^{'> <ws>? (Setting (<ws> Setting)*)? <ws>? <'}'>
<TreeItem>   = Setting / QuotedName / Data / TreeLoop / Mark / MuNumber / StringLit / TreeWord
TreeLoop     = <'[~]'>
TreeWord     = #'[a-zA-Z_][a-zA-Z0-9_\-?>+]*(?:/[a-zA-Z_][a-zA-Z0-9_\-?>+]*)?(?![:.])'

(* '( … ): code held, not run -- the quoted counterpart of '[ … ]. *)
Quotation = <"'("> <ws>? (MuItem (<ws> MuItem)*)? <ws>? <')'>

(* ( … ): run now, what it leaves gathered into one line
   in brackets; as the text's ( ) holds what a command changes now,
   ( … ) 1 + moves all of it, a repeat's endings too. *)
Group = <'('> <ws>? (MuItem (<ws> MuItem)*)? <ws>? <')'>

<MuNumber>  = SignedRatio / SignedFloat / SignedInt

(* repeat 2 [ … ] -- the text's repeat, read as one value (what
   mu's repeat word gives); repeat followed by anything but a count and
   a [ ] is the word, so [a] 2 repeat [c] volta is words. shuffle [ … ]
   likewise: the text's part ordered as it plays; shuffle followed by
   anything but a [ ] is the word. *)

(* D.major, B&.minor, F#.dorian -- a key, as !key: writes it but with
   its scale always given (a bare D is the note). # sharp, & flat. *)
KeyValue = #'[A-Ga-g][#&]?\.[a-zA-Z][a-zA-Z0-9_\-]*'

(* M:3/4, T:8=200, vol:mf, K:D.major -- a setting written alone, as !M:3/4
   writes it in a line but without the !, nothing between name, : and the
   value: read as the context ^{ !M:3/4 } (the parse is rewritten, see
   musics.mu.grammar), so x M:3/4 with lays it under x. A leaf wins over
   it (c:m7 is a chord), and name: with a space after it is still an id. *)
KeyLit    = KeyName <':'> KeySpec At?
AssignLit = AssignName <':'> Value RampMark? At?

(* | -- a mark on the stack: a gathering word (zip, >ctx) takes what lies
   above the nearest one, PostScript's mark; | … |||| also name the bar
   line >> waits for. A bar line is written inside brackets, [c d | e f],
   as in the text. *)
Mark = #'\|{1,4}'

(* :motif -- a repo name, pushed as a name (for R! and R@). :bass/onsets --
   the input of a live voice, a reference: @ reads it, ! stores into it. *)
IdName = <':'> #'[a-zA-Z][a-zA-Z0-9_]*' (<'/'> #'[a-zA-Z][a-zA-Z0-9_\-?]*')?

(* 'motif -- a name, held: what := binds a value to, or the word execute
   runs: 'dup, '+, 'reverse. \motif, musics text's VarRef, is the
   value bound to it, bare or inside a literal. *)
QuotedName = <"'"> (VarName / WordName / SymbolWord)

(* $[047] $(037) $<001110> -- a set of pitch classes: classes, a prime
   form, an interval vector, the numbers glued together (T is 10, E is 11)
   or apart ($<12 12 12 12 12 6>). mu's own: musics text has no set. *)
PcSet     = <'$'> (PcClasses / PcPrime / PcVector)
PcClasses = <'['> <ws>? PcNums? <ws>? <']'>
PcPrime   = <'('> <ws>? PcNums? <ws>? <')'>
PcVector  = <'<'> <ws>? PcNums? <ws>? <'>'>
PcNums    = #'[0-9TE]+(?: +[0-9TE]+)*'

(* $a -- a local, inside a word's body. *)
Local = <'$'> #'[a-zA-Z_][a-zA-Z0-9_\-]*'

(* transpose c d ( … ), R ( … ), grace c16 d4 … outside any brackets:
   musics text's commands, written inside a line ([transpose c d ( … )]);
   parsed so they can be refused with a clear message, never taken for
   the words of those names, which run on what is already on the stack. *)
TopCommand = transpose / row-form / grace / shuffle-now / rotate-now

(* An instruction outside any brackets: parsed so it can be refused with
   a clear message, never run. *)
LooseInstruction = Instruction

(* [R] -- the retrograde, a word although [R] is musics text for a line
   with one bar's rest: it comes before the literals, and only exactly
   [R] -- [ R ], [R1], [r1] are still that line. *)
Retrograde = <'[R]'>
(* [[]] -- the measures word, before the literals as [R] is: a line
   holding an empty line is written [ [] ]. *)
Measures = <'[[]]'>
(* [] -- a line with nothing in it, a value of mu's only: musics text
   needs an element or an id in its [ ] (grammar.clj reads it as the
   Sequence it is). *)
EmptyLine = <'['> <ws>? <']'>
(* {2} {3} … {n} -- the top n side by side, a { } of n parts; no musics
   text, since a bare number is no element. *)
Parallels = <'{'> #'[0-9]+' <'}'>
(* [2] [3] … [n] -- the top n one after another, a line of n elements. *)
Lines = <'['> #'[0-9]+' <']'>
(* A word: a name or one of the symbol words, either possibly ns/…; a
   name may start with + (+octave, say), ? or > before a letter (>ctx). *)
Word     = WordName | SymbolWord
<SymbolWord> = #'(?:[a-zA-Z_][a-zA-Z0-9_\-?>+]*/)?(?:->>\+|->>|->\+|->|<<-|<-|\.>>\+|\.>>|\.>\+|\.>|\.<<|\.<|>>\+|>>|>\+|1\+|1-|2dup|2drop|-rot|\[\[\]\]|\[RI\]|\[R\]|\[I\]|\[\*\]|\[/\]|\[\+\]|\{\+\}|\[%\]|\[\?\]|\[~\]|\[M\]|\[H\]|\[T\]|\[!\]|\[\|\|\]|\[\|\]|\[\\\]|\[:\]|\*\*|\*|\+|-|/|,|\.s|\.\.|\.|<<|<>|<=|>=|:=|=|<|>|R!!|R!|R@|!|@|\[_\])'
WordName = #'(?:[a-zA-Z_][a-zA-Z0-9_\-?>+]*/)?(?:[a-zA-Z_][a-zA-Z0-9_\-?>+]*|[+>][a-zA-Z][a-zA-Z0-9_\-?>+]*|\?[a-zA-Z_][a-zA-Z0-9_\-?>+]*+(?![:./]))'
